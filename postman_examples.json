{
  "info": {
    "name": "DEOS API - Ejemplos de Prueba",
    "description": "Colección de ejemplos para probar todas las funcionalidades del proyecto DEOS",
    "version": "1.0.0"
  },
  "examples": [
    {
      "name": "1. Clasificar Texto",
      "method": "POST",
      "url": "http://localhost:8000/classify",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "text": "Este video habla sobre inteligencia artificial y machine learning, explicando conceptos fundamentales de deep learning.",
        "top_k": 3,
        "threshold": 0.3
      }
    },
    {
      "name": "2. Procesar Video de YouTube (Audio)",
      "method": "POST", 
      "url": "http://localhost:8000/audio/process",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
        "topic": "tecnologia"
      }
    },
    {
      "name": "3. Obtener Lista de Videos",
      "method": "GET",
      "url": "http://localhost:8000/videos",
      "headers": {},
      "params": {
        "limit": "10",
        "skip": "0"
      }
    },
    {
      "name": "4. Filtrar Videos por Tópico",
      "method": "GET", 
      "url": "http://localhost:8000/videos?topic=tecnologia",
      "headers": {}
    },
    {
      "name": "5. Obtener Detalles de Video",
      "method": "GET",
      "url": "http://localhost:8000/videos/1",
      "headers": {}
    },
    {
      "name": "6. Procesar PDF",
      "method": "POST",
      "url": "http://localhost:8000/ingestion/pdf",
      "headers": {
        "Content-Type": "multipart/form-data"
      },
      "body": {
        "file": "(archivo PDF a subir)",
        "topic": "investigacion"
      }
    },
    {
      "name": "7. Resumir Texto",
      "method": "POST",
      "url": "http://localhost:8000/audio/summarize", 
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "text": "Este es un texto largo que necesita ser resumido. Habla sobre diversos temas importantes que deben ser condensados en un resumen más corto y manejable para el usuario.",
        "summary_type": "medium"
      }
    },
    {
      "name": "8. Obtener Documentación API",
      "method": "GET",
      "url": "http://localhost:8000/docs",
      "headers": {}
    }
  ],
  "variables": {
    "base_url": "http://localhost:8000",
    "test_youtube_url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
  }
}