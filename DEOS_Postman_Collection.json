							"mode": "raw",
							"raw": "{\n  \"url\": \"{{test_youtube_url}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/audio/download",
							"host": ["{{base_url}}"],
							"path": ["audio", "download"]
						}
					},
					"response": []
